/*
 * TOTEM — keymap
 *
 * - Tecla exterior inferior izquierda = LSHIFT (tap_dance: 1x shift, 2x caps lock)
 * - LOWER + RAISE = capa ADJ (tri-layer) + LCTRL como modificador
 *   → en capa ADJ las letras envían Ctrl+letra (Ctrl+C, Ctrl+V, etc.)
 * - Capa ADJ: fila superior derecha = perfiles Bluetooth 0-4
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define LOWER 1
#define RAISE 2
#define ADJ   3

/ {
    behaviors {
        td_shift_caps: tap_dance_shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
//          ┌───────┬───────┬───────┬───────┬───────┐    ┌───────┬───────┬───────┬───────┬───────┐
//          │   Q   │   W   │   E   │   R   │   T   │    │   Y   │   U   │   I   │   O   │   P   │
              &kp Q   &kp W   &kp E   &kp R   &kp T        &kp Y   &kp U   &kp I   &kp O   &kp P
//          │   A   │   S   │   D   │   F   │   G   │    │   H   │   J   │   K   │   L   │   ;   │
              &kp A   &kp S   &kp D   &kp F   &kp G        &kp H   &kp J   &kp K   &kp L   &kp SEMI
//  ┌───────┼───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┼───────┼───────┐
//  │ SHF/CL│   Z   │   X   │   C   │   V   │   B   │    │   N   │   M   │   ,   │   .   │   /   │ BSPC  │
  &td_shift_caps &kp Z &kp X  &kp C   &kp V   &kp B        &kp N   &kp M &kp COMMA &kp DOT &kp FSLH &kp BSPC
//  └───────┴───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┴───────┴───────┘
//                  │  GUI  │ LOWER │ ENTER │              │ SPACE │ RAISE │  ESC  │
                    &kp LGUI &mo LOWER &kp RET          &kp SPACE &mo RAISE &kp ESC
            >;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
//          ┌───────┬───────┬───────┬───────┬───────┐    ┌───────┬───────┬───────┬───────┬───────┐
//          │   1   │   2   │   3   │   4   │   5   │    │   6   │   7   │   8   │   9   │   0   │
              &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
//          │ CTRL  │       │       │       │       │    │   ←   │   ↓   │   ↑   │   →   │  TAB  │
            &kp LCTRL &none   &none   &none   &none      &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp TAB
//  ┌───────┼───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┼───────┼───────┐
//  │ (shf) │       │       │       │       │       │    │       │       │       │       │       │   '   │
     &trans   &none   &none   &none   &none   &none        &none   &none   &none   &none   &none  &kp SQT
//  └───────┴───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┴───────┴───────┘
//                  │  GUI  │ ▽▽▽▽▽ │ SPACE │              │ SPACE │ ▽▽▽▽▽ │  GUI  │
                    &kp LGUI  &trans &kp SPACE          &kp SPACE  &trans  &kp RGUI
            >;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
//          ┌───────┬───────┬───────┬───────┬───────┐    ┌───────┬───────┬───────┬───────┬───────┐
//          │   !   │   @   │   #   │   $   │   %   │    │   ^   │   &   │   *   │   (   │   )   │
             &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT  &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR
//          │       │       │       │       │       │    │   -   │   =   │   [   │   ]   │   \   │
              &none   &none   &none   &none   &none      &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
//  ┌───────┼───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┼───────┼───────┐
//  │ (shf) │   `   │       │       │       │       │    │   _   │   +   │   {   │   }   │   |   │   ~   │
     &trans &kp GRAVE &none   &none   &none   &none      &kp UNDER &kp PLUS &kp LBRC &kp RBRC &kp PIPE &kp TILDE
//  └───────┴───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┴───────┴───────┘
//                  │  GUI  │ ▽▽▽▽▽ │ SPACE │              │ SPACE │ ▽▽▽▽▽ │  GUI  │
                    &kp LGUI  &trans &kp SPACE          &kp SPACE  &trans  &kp RGUI
            >;
        };

        adjust_layer {
            display-name = "ADJ";
            // LOWER+RAISE activa esta capa.
            // Las letras envían Ctrl+letra → Ctrl+C = copiar, Ctrl+V = pegar, etc.
            bindings = <
//          ┌───────┬───────┬───────┬───────┬───────┐    ┌───────┬───────┬───────┬───────┬───────┐
//          │ BOOT  │ Ct+W  │ Ct+E  │ Ct+R  │ Ct+T  │    │ BT 0  │ BT 1  │ BT 2  │ BT 3  │ BT 4  │
            &bootloader &kp LC(W) &kp LC(E) &kp LC(R) &kp LC(T)  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
//          │ RESET │ Ct+A  │ Ct+S  │ Ct+D  │ Ct+F  │    │       │       │       │       │       │
            &sys_reset &kp LC(A) &kp LC(S) &kp LC(D) &kp LC(F)   &none   &none   &none   &none   &none
//  ┌───────┼───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┼───────┼───────┐
//  │ (shf) │USB/BLE│ Ct+X  │ Ct+C  │ Ct+V  │ Ct+B  │    │ Ct+N  │ Ct+Z  │ Ct+Y  │       │       │BT CLR │
     &trans &out OUT_TOG &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(B)  &kp LC(N) &kp LC(Z) &kp LC(Y) &none &none &bt BT_CLR
//  └───────┴───────┼───────┼───────┼───────┼───────┤    ├───────┼───────┼───────┼───────┴───────┴───────┘
//                  │  GUI  │ ▽▽▽▽▽ │ SPACE │              │ ENTER │ ▽▽▽▽▽ │  GUI  │
                    &kp LGUI  &trans &kp SPACE           &kp RET   &trans  &kp RGUI
            >;
        };
    };
};
